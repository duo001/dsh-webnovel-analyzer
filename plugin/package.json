{
  "name": "@local/webnovel-analyzer",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "description": "短篇网文拆文分析工具：22 维并发 LLM 分析、240 条网络热梗库检索、AI 热梗卡片生成（四件套+各维度网文写法）。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./dimensions": "./dimensions.js",
    "./trope-store": "./trope-store.js",
    "./trope-prompts": "./trope-prompts.js",
    "./locale/zh.json": "./locale/zh.json",
    "./locale/en.json": "./locale/en.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "dimensions.js",
    "trope-store.js",
    "trope-prompts.js",
    "sample.txt",
    "data",
    "cordis.patch.yml",
    "locale",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "slots"
      ]
    }
  }
}
